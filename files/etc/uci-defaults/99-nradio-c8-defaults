#!/bin/sh
# NRadio C8 (WT9104 / C8-688) 首次启动默认值
#
# IPv6 说明：MT5700M 在 IP 直通（/etc/config/mt5700 mode=3）下只把运营商的 /64
# 通过 RA 交给下挂口，**不提供 DHCPv6-PD**。所以 LAN 不能靠前缀委派拿公网 v6，
# 改用 odhcpd 的 RA/NDP 中继（relay）：客户端直接使用上游 2409:…/64，NDP 由
# odhcpd 代理，端到端可达。
#
# 注意：`uci batch` 中任一条命令失败会**静默中断后续所有命令**（返回码仍为 0），
# 因此把可能失败的操作（delete 不存在的项）放到 batch 外单独执行。

# relay 模式下用不到 server 专属项，存在则删掉；不存在时 uci -q delete 会被忽略
uci -q delete dhcp.lan.ra_management
uci -q delete dhcp.lan.ra_default

uci -q batch <<-EOF
	set system.@system[0].hostname='C8'
	set system.@system[0].timezone='CST-8'
	set system.@system[0].zonename='Asia/Shanghai'
	set network.lan.ipaddr='192.168.66.1'
	set network.lan.netmask='255.255.255.0'
	set network.lan.delegate='0'
	set dhcp.lan.leasetime='12h'
	# ---- IPv6：odhcpd RA/NDP 中继 ----
	# 上游 eth1（wan/wan6）作为 relay master
	set dhcp.wan.master='1'
	set dhcp.wan.ra='relay'
	set dhcp.wan.dhcpv6='relay'
	set dhcp.wan.ndp='relay'
	# 下游 br-lan 做 relay
	set dhcp.lan.ra='relay'
	set dhcp.lan.dhcpv6='relay'
	set dhcp.lan.ndp='relay'
	# 客户端有真实公网 v6，不再屏蔽 AAAA
	set dhcp.@dnsmasq[0].filter_aaaa='0'
	# 固定中文界面（default-settings 默认是 auto，跟随浏览器）
	set luci.main.lang='zh_cn'
	commit system
	commit network
	commit dhcp
	commit luci
EOF

# RDNSS：中继会把上游模组的 RDNSS（链路本地 fe80::…，LAN 不可达）一起转发，
# 这里显式改成路由器自己（dnsmasq 在 br-lan 的 ULA 上监听），否则 LAN 客户端
# 的 IPv6 DNS 会解析失败。ula_prefix 由 config_generate 在 preinit 生成，此处可用。
ula_prefix="$(uci -q get network.globals.ula_prefix)"
if [ -n "$ula_prefix" ]; then
	uci -q set dhcp.lan.dns="${ula_prefix%%/*}1"
	uci -q commit dhcp
fi

# ---- 无线调优 ----
# /etc/config/wireless 由 /sbin/wifi config 在 /etc/init.d/boot 中、本脚本之前生成。
if [ -n "$(uci -q get wireless.radio0.band)" ] && [ -n "$(uci -q get wireless.radio1.band)" ]; then
	# 出厂 eeprom 的 wifi MAC 非法（dmesg: "Invalid MAC address"），驱动每次启动都会
	# 随机生成 BSSID；按 label MAC 派生固定值（label=LAN，WAN=label+2，取 +1/+3 不冲突）
	. /lib/functions/system.sh
	label="$(get_mac_label)"
	nradio_mac_add() {
		local h
		h=$((0x$(echo "$1" | tr -d ':')))
		h=$((h + $2))
		printf '%012x' "$h" | sed 's/\(..\)/\1:/g; s/:$//'
	}
	if [ -n "$label" ]; then
		wifi24="$(nradio_mac_add "$label" 1)"
		wifi5="$(nradio_mac_add "$label" 3)"
		[ -n "$(uci -q get wireless.default_radio0.device)" ] && uci -q set wireless.default_radio0.macaddr="$wifi24"
		[ -n "$(uci -q get wireless.default_radio1.device)" ] && uci -q set wireless.default_radio1.macaddr="$wifi5"
	fi
	# 实测环境：2.4G 用 ch11（ch1 有 -43dBm 邻区、ch6/7 有强邻区）；
	#            5G 用 ch149（ch36 与 -47dBm 邻区同频，ch149 基本空闲且 CN 允许更高功率）
	uci -q set wireless.radio0.country='CN'
	uci -q set wireless.radio1.country='CN'
	uci -q set wireless.radio0.channel='11'
	uci -q set wireless.radio1.channel='149'
	uci -q commit wireless
fi

# ---- 指示灯 ----
# blue:power 是“开机点一次就不再变”的静态灯：厂商 DT 把 led-boot/led-failsafe/
# led-running/led-upgrade 全指向它，/etc/init.d/done 只调 set_state 点亮一次。
# 这里显式声明为 default-on，让 /etc/init.d/led start 也能重建它（ledctl 的“开灯”
# 会调它），并让 ledctl status 的“恢复来源”显示为 uci。
# 已有同名声明就跳过（例如设备上手工加过 blue:power 的 led 段）。
if ! uci -q show system 2>/dev/null | grep -q "\.sysfs='blue:power'$"; then
	uci -q batch <<-EOF
		set system.led_power=led
		set system.led_power.name='power'
		set system.led_power.sysfs='blue:power'
		set system.led_power.trigger='default-on'
	EOF
	uci -q commit system
fi

# ---- 本地时间服务（NTP Server，供 LAN 客户端对时）----
# busybox sysntpd 已内建 server 能力（enable_server=1 → ntpd -l -I br-lan）；
# 只监听 lan，避免在 WAN 上变成 UDP/123 放大面。lan zone 是 input ACCEPT，无需防火墙改动。
uci -q set system.ntp.enable_server='1'
uci -q set system.ntp.interface='lan'
uci -q commit system

# ---- mDNS / DNS-SD：用 OpenWrt 原生的 umdns，不再引入 avahi ----
# umdns 约 17 KB（依赖 libubox/libubus/blobmsg，均已在包集），且 dawn 本身就依赖它；
# 它的出厂配置已是 `option jail 1` + `list network lan`，只在 lan 上应答，无需再改。
# dawn 保持默认 network_option=2（TCP + umdns 发现），两者天然配套。
# 对比：avahi-dbus-daemon 全家桶（含 dbus）约 485 KB，且有“与 umdns 抢 5353”的互斥问题。
# 将来若要跨 VLAN 反射 mDNS，再加 `mdns-repeater`（约 6 KB）即可，见 docs/RFC-003。

exit 0
