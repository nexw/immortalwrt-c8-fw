#!/bin/sh
#
# fanctl — NRadio C8 (WT9104 / C8-688) PWM 风扇温控（userspace 兜底实现）
#
# 背景：DTS 里已有 pwm-fan 节点（pwmchip0/pwm0，25 kHz），但 cpu-thermal 的
#       cooling-maps 只绑了 WiFi、没绑风扇，所以内核 governor 不会驱动风扇。
#       本脚本用 userspace 闭环补上这一段。
#       注：25.12.2 起的镜像已经带了 kmod-hwmon-pwmfan（内建，lsmod 看不到是正常的），
#       驱动会独占 pwm0 并默认停在 cooling-levels[0] = 50%；下面的 hwmon 通路
#       就是为这个情况准备的（见 kernel_driver）。
#
# 若镜像带上了 pwmfan 驱动（/sys/class/hwmon/*/name == pwmfan），它会独占 pwm0。
# 此时默认改走 hwmon 的 pwm1（0-255）继续控温（option kernel_driver='hwmon'）；
# 若 DTS 给风扇绑了 cooling-map、想交回内核 governor，把该项设为 'yield' 即可。
#
# 配置生效（v1.1 起走 procd 触发器，见 docs/RFC-002-led-fan-packaging.md）：
#   LuCI / `ubus call uci commit` → config.change 事件 → /etc/init.d/fancontrol reload
#   → procd_send_signal → 本进程收到 SIGHUP → 原地重读 /etc/config/fancontrol
#   （不重启、不断温控）。命令行 `uci commit` 不发 config.change 事件
#   （该构建 uci 未链 libubus，已实测），需显式 /etc/init.d/fancontrol reload。
#
# 用法：
#   fanctl daemon        前台常驻温控循环（由 /etc/init.d/fancontrol 经 procd 拉起）
#   fanctl status        打印温度 / 占空比 / 风扇供电 / 控制模式
#   fanctl set <pct>     手动设置占空比（1-100，下次温控循环会被纠正）
#   fanctl auto          交回自动温控（立即按曲线设一次）
#   fanctl temp          只打印 CPU 温度（摄氏度）
#   fanctl curve         打印当前生效的温度-转速曲线
#
# 注意：不要用 set -u —— /lib/functions.sh 里引用了未定义的 $IPKG_INSTROOT

STATE=/var/run/fanctl.state

# ---- 默认值（可被 /etc/config/fancontrol 覆盖）----
TEMP_ZONE=/sys/class/thermal/thermal_zone0/temp
PWM_CHIP=/sys/class/pwm/pwmchip0
PWM_DIR=/sys/class/pwm/pwmchip0/pwm0
PERIOD_NS=40000          # 25 kHz
INTERVAL=10              # 轮询秒数
MIN_DUTY=25              # 下限，太低风扇不转（堵转保护）
MAX_DUTY=100
HYSTERESIS=3000          # 迟滞 3.0 ℃，避免在阈值附近来回抖
DOWN_STEP=10             # 每次最多降 10%，抑制转速突变啸叫
FORCE_MAX_TEMP=95000     # 超过则立即 100%
FAN_POWER_GPIO=/sys/class/gpio/fan-hw/value
# 内核 pwmfan 驱动占了 pwm0 时：hwmon=改走 hwmon/pwm1 继续控温；yield=让位给内核
KERNEL_DRIVER=hwmon
# 运行期解析结果
PWM_MODE=                # sysfs | hwmon | yield | none
PWM_NODE=                # 实际写入的节点
# temp_md:duty%  升序；中间线性插值。
# 实机参考：原先只有开机 50% 兜底时空载 ~77 ℃；按本曲线空载稳定在 ~71-72 ℃（≈68%），
# 所以中段压低、把满速（100%）留给 85 ℃ 以上。
CURVE="45000:25 55000:30 60000:38 65000:48 70000:60 75000:72 80000:88 85000:100"

# shell 的 $(( )) 会把带前导零的字面量当八进制解析（busybox ash 不支持 10#），
# 所以 "08"/"09" 会直接报 arithmetic syntax error。凡是要进 $(( )) 的数字先过一遍 dec。
dec() {
	v=$1
	while [ "${v#0}" != "$v" ] && [ ${#v} -gt 1 ]; do v=${v#0}; done
	[ -n "$v" ] || v=0
	echo "$v"
}

load_config() {
	[ -f /etc/config/fancontrol ] || return 0
	[ -f /lib/functions.sh ] || return 0
	. /lib/functions.sh
	config_load fancontrol
	config_get TEMP_ZONE      main temp_zone       "$TEMP_ZONE"
	config_get PWM_DIR        main pwm_dir         "$PWM_DIR"
	config_get PWM_CHIP       main pwm_chip        "$PWM_CHIP"
	config_get PERIOD_NS      main period_ns       "$PERIOD_NS"
	config_get INTERVAL       main interval        "$INTERVAL"
	config_get MIN_DUTY       main min_duty        "$MIN_DUTY"
	config_get MAX_DUTY       main max_duty        "$MAX_DUTY"
	config_get HYSTERESIS     main hysteresis      "$HYSTERESIS"
	config_get DOWN_STEP      main down_step       "$DOWN_STEP"
	config_get FORCE_MAX_TEMP main force_max_temp  "$FORCE_MAX_TEMP"
	config_get FAN_POWER_GPIO main fan_power_gpio  "$FAN_POWER_GPIO"
	config_get KERNEL_DRIVER  main kernel_driver   "$KERNEL_DRIVER"
	config_get CURVE          main curve           "$CURVE"

	# 避免 "08"/"09" 在 $(( )) 里被当八进制
	PERIOD_NS=$(dec "$PERIOD_NS")
	INTERVAL=$(dec "$INTERVAL")
	MIN_DUTY=$(dec "$MIN_DUTY")
	MAX_DUTY=$(dec "$MAX_DUTY")
	HYSTERESIS=$(dec "$HYSTERESIS")
	DOWN_STEP=$(dec "$DOWN_STEP")
	FORCE_MAX_TEMP=$(dec "$FORCE_MAX_TEMP")
}

# 内核 pwmfan 驱动是否已接管（接管后 pwm0 被驱动独占，我们不能再写）
kernel_fan_hwmon() {
	for h in /sys/class/hwmon/hwmon*; do
		[ -r "$h/name" ] || continue
		[ "$(cat "$h/name" 2>/dev/null)" = "pwmfan" ] && { echo "$h"; return 0; }
	done
	return 1
}

# 解析温控走哪条通路（每个 tick 重解析：内核驱动可能中途上下线）
resolve_pwm() {
	PWM_MODE=sysfs
	PWM_NODE=$PWM_DIR/duty_cycle
	hz=$(kernel_fan_hwmon) || return 0
	if [ "$KERNEL_DRIVER" = "yield" ]; then
		PWM_MODE=yield; PWM_NODE=$hz
	elif [ -w "$hz/pwm1" ]; then
		PWM_MODE=hwmon; PWM_NODE=$hz/pwm1
	else
		PWM_MODE=none;  PWM_NODE=$hz
	fi
	return 0
}

read_temp() {
	t=$(cat "$TEMP_ZONE" 2>/dev/null)
	case "$t" in
		''|*[!0-9]*) return 1 ;;
	esac
	echo "$t"
}

ensure_fan_power() {
	[ -w "$FAN_POWER_GPIO" ] || return 0
	[ "$(cat "$FAN_POWER_GPIO" 2>/dev/null)" = "1" ] || echo 1 > "$FAN_POWER_GPIO" 2>/dev/null
	return 0
}

ensure_pwm() {
	# 内核驱动接管时（hwmon/yield）不需要我们配置 pwm0
	[ "$PWM_MODE" = "sysfs" ] || return 0
	[ -d "$PWM_DIR" ] || { echo 0 > "$PWM_CHIP/export" 2>/dev/null; sleep 1; }
	[ -d "$PWM_DIR" ] || return 1

	if [ "$(cat "$PWM_DIR/period" 2>/dev/null)" != "$PERIOD_NS" ]; then
		# 改周期前先把占空比压到新周期上限，否则 duty>period 会被内核拒绝
		echo "$PERIOD_NS" > "$PWM_DIR/duty_cycle" 2>/dev/null
		echo "$PERIOD_NS" > "$PWM_DIR/period" 2>/dev/null
	fi
	[ "$(cat "$PWM_DIR/enable" 2>/dev/null)" = "1" ] || echo 1 > "$PWM_DIR/enable" 2>/dev/null
	return 0
}

# 百分比 -> 实际值并写入；写失败返回非 0（调用方保留旧档位，不会盲目更新状态）
#   sysfs 通路：写 pwm0/duty_cycle（ns）
#   hwmon 通路：写 hwmon/pwm1（0-255，内核 pwmfan 已接管 pwm0 时）
set_duty_pct() {
	pct=$1
	[ "$pct" -lt 0 ] && pct=0
	[ "$pct" -gt 100 ] && pct=100
	case "$PWM_MODE" in
		hwmon) echo $(( 255 * pct / 100 )) > "$PWM_NODE" 2>/dev/null || return 1 ;;
		sysfs) echo $(( PERIOD_NS * pct / 100 )) > "$PWM_NODE" 2>/dev/null || return 1 ;;
		*)     return 1 ;;
	esac
	return 0
}

# 当前占空比（百分比），用于迟滞判断
read_duty_pct() {
	case "$PWM_MODE" in
		hwmon)
			v=$(cat "$PWM_NODE" 2>/dev/null)
			echo $(( ${v:-0} * 100 / 255 ))
			;;
		sysfs)
			v=$(cat "$PWM_NODE" 2>/dev/null)
			p=$(cat "$PWM_DIR/period" 2>/dev/null)
			if [ -n "$p" ] && [ "${p:-0}" -gt 0 ]; then echo $(( ${v:-0} * 100 / p )); else echo 0; fi
			;;
		*) echo 0 ;;
	esac
}

# 温度 -> 目标占空比（曲线线性插值）
duty_for_temp() {
	t=$1
	prev_t= prev_d= out=$MIN_DUTY
	for pt in $CURVE; do
		tt=${pt%%:*}
		dd=${pt##*:}
		if [ "$t" -le "$tt" ]; then
			if [ -n "$prev_t" ] && [ "$tt" -gt "$prev_t" ]; then
				out=$(( prev_d + (dd - prev_d) * (t - prev_t) / (tt - prev_t) ))
			else
				out=$dd
			fi
			echo "$out"
			return
		fi
		prev_t=$tt
		prev_d=$dd
		out=$dd
	done
	echo "$out"
}

clamp_duty() {
	d=$1
	[ "$d" -lt "$MIN_DUTY" ] && d=$MIN_DUTY
	[ "$d" -gt "$MAX_DUTY" ] && d=$MAX_DUTY
	echo "$d"
}

log() {
	logger -t fanctl "$*" 2>/dev/null
	# 只有交互式前台运行时才回显，避免 procd 下 stdout + syslog 双份日志
	[ -t 1 ] && echo "$(date '+%F %T') $*"
	return 0
}

# 可被信号打断的 sleep：后台 sleep + 前台 wait。
# busybox ash 直接 `sleep N` 时，trap 必须等睡满才执行；wait 会被信号立即打断。
# 实机验证见 docs/RFC-002-led-fan-packaging.md §3.1。
sleep_int() {
	sleep "$1" &
	_sleep_pid=$!
	wait "$_sleep_pid"
	_sleep_pid=
	return 0
}

sleep_pid_kill() {
	[ -n "$_sleep_pid" ] && kill "$_sleep_pid" 2>/dev/null
	_sleep_pid=
	return 0
}

cmd_status() {
	resolve_pwm
	hz=$(kernel_fan_hwmon) || hz=
	t=$(read_temp) || t=
	pwm_ns=$(cat "$PWM_DIR/duty_cycle" 2>/dev/null)
	period=$(cat "$PWM_DIR/period" 2>/dev/null)
	en=$(cat "$PWM_DIR/enable" 2>/dev/null)
	pwr=$(cat "$FAN_POWER_GPIO" 2>/dev/null)

	case "$PWM_MODE" in
		hwmon) printf 'mode       : hwmon-pwmfan %s（内核驱动占着 pwm0，fanctl 走 hwmon/pwm1 控温）\n' "$PWM_NODE" ;;
		yield) printf 'mode       : kernel-pwmfan %s（配置为让位，交回内核 governor）\n' "$PWM_NODE" ;;
		sysfs) printf 'mode       : userspace-sysfs %s\n' "$PWM_NODE" ;;
		*)     printf 'mode       : none（pwm0 与 pwmfan/pwm1 都不可用）\n' ;;
	esac
	if [ -n "$t" ]; then
		printf 'cpu temp   : %s.%s C\n' "$((t / 1000))" "$((t % 1000 / 100))"
	else
		printf 'cpu temp   : (读取失败 %s)\n' "$TEMP_ZONE"
	fi
	if [ "$PWM_MODE" = "hwmon" ]; then
		v=$(cat "$PWM_NODE" 2>/dev/null)
		printf 'pwm duty   : %s / 255 = %s%%\n' "${v:-?}" "$(( ${v:-0} * 100 / 255 ))"
	elif [ -n "$period" ] && [ -n "$pwm_ns" ] && [ "$period" -gt 0 ]; then
		printf 'pwm duty   : %s ns / %s ns = %s%%  (enabled=%s)\n' \
			"$pwm_ns" "$period" "$((pwm_ns * 100 / period))" "${en:-?}"
	else
		printf 'pwm duty   : (pwm0 未就绪)\n'
	fi
	printf 'fan power  : gpio %s\n' "${pwr:-?}"
	if [ -s "$STATE" ]; then
		printf 'last tick  : %s\n' "$(cat "$STATE")"
	fi
	[ -n "$t" ] && printf 'target duty: %s%%\n' "$(clamp_duty "$(duty_for_temp "$t")")"
}

cmd_curve() {
	printf 'interval=%ss  hysteresis=%s md  min=%s%%  max=%s%%  down_step=%s%%\n' \
		"$INTERVAL" "$HYSTERESIS" "$MIN_DUTY" "$MAX_DUTY" "$DOWN_STEP"
	printf '%-8s %s\n' "temp(C)" "duty(%)"
	for pt in $CURVE; do
		tt=${pt%%:*}
		printf '%-8s %s\n' "$((tt / 1000))" "${pt##*:}"
	done
}

cmd_daemon() {
	resolve_pwm
	case "$PWM_MODE" in
		yield) log "内核 pwmfan 驱动（$PWM_NODE）已接管且 kernel_driver=yield，fanctl 退出"; return 0 ;;
		none)  log "错误：pwm0 与 pwmfan/pwm1 都不可用，风扇温控未启动"; return 1 ;;
		hwmon) log "内核 pwmfan 已独占 pwm0，改走 $PWM_NODE（0-255）继续控温" ;;
	esac
	if ! ensure_pwm; then
		log "错误：$PWM_DIR 不可用，风扇温控未启动"
		return 1
	fi
	ensure_fan_power

	cur=$(read_duty_pct)
	log "温控启动 mode=$PWM_MODE interval=${INTERVAL}s min=${MIN_DUTY}% max=${MAX_DUTY}% 起始=${cur}%"

	# HUP：uci 变更（procd 触发器）→ 原地重读配置，不重启进程、不断温控
	# TERM/INT：收掉后台 sleep 子进程后退出，避免留下孤儿
	trap 'reload_wanted=1' HUP
	trap 'sleep_pid_kill; exit 0' TERM INT
	trap 'sleep_pid_kill' EXIT
	reload_wanted=0

	while :; do
		if [ "$reload_wanted" = "1" ]; then
			reload_wanted=0
			load_config
			log "配置已重载：interval=${INTERVAL}s min=${MIN_DUTY}% max=${MAX_DUTY}% hysteresis=${HYSTERESIS} down_step=${DOWN_STEP} force_max=${FORCE_MAX_TEMP}"
		fi
		# 每个 tick 重解析：内核 pwmfan 驱动可能中途上线/下线
		resolve_pwm
		case "$PWM_MODE" in
			yield) log "检测到内核 pwmfan 并配置为让位，fanctl 退出"; return 0 ;;
			none)  log "PWM 通路失效（既无 pwm0 也无 pwmfan/pwm1），fanctl 退出"; return 1 ;;
		esac
		ensure_fan_power
		if ! t=$(read_temp); then
			# 温度读不到：宁可信其热，拉满并告警，不要静默失控
			want=$MAX_DUTY
			reason="温度读取失败，保守拉满"
		elif [ "$t" -ge "$FORCE_MAX_TEMP" ]; then
			want=$MAX_DUTY
			reason="温度越过 $((FORCE_MAX_TEMP / 1000))C 硬阈值"
		else
			want=$(duty_for_temp "$t")
			# 迟滞：只有当"温度+迟滞"对应的档位都低于当前档位时才允许降速
			down=$(duty_for_temp $(( t + HYSTERESIS )))
			if [ "$want" -lt "$cur" ] && [ "$down" -ge "$cur" ]; then
				want=$cur
			fi
			# 降速限幅
			if [ "$want" -lt "$cur" ]; then
				lim=$(( cur - DOWN_STEP ))
				[ "$want" -lt "$lim" ] && want=$lim
			fi
			reason=
		fi
		want=$(clamp_duty "$want")

		if [ "$want" != "$cur" ]; then
			if set_duty_pct "$want"; then
				if [ -n "$reason" ]; then
					log "temp=${t:-?}md duty: ${cur}% -> ${want}%  ($reason)"
				else
					log "temp=${t}md($((t / 1000)).$((t % 1000 / 100))C) duty: ${cur}% -> ${want}%"
				fi
				cur=$want
			else
				log "写入 $PWM_NODE 失败（want=${want}%），保持 ${cur}%"
			fi
		fi
		echo "temp=${t:-na}md duty=${cur}%" > "$STATE" 2>/dev/null
		sleep_int "$INTERVAL"
	done
}

load_config
case "${1:-status}" in
	daemon) cmd_daemon ;;
	status) cmd_status ;;
	curve)  cmd_curve ;;
	temp)
		t=$(read_temp) || exit 1
		printf '%s.%s\n' "$((t / 1000))" "$((t % 1000 / 100))"
		;;
	set)
		pct=${2:-}
		case "$pct" in
			''|*[!0-9]*) echo "用法: fanctl set <1-100>" >&2; exit 1 ;;
		esac
		pct=$(dec "$pct")
		resolve_pwm
		case "$PWM_MODE" in
			none)  echo "PWM 通路不可用（pwm0 与 pwmfan/pwm1 都没有）" >&2; exit 1 ;;
			yield) echo "kernel_driver=yield，内核 driver 接管中，未手动设置" >&2; exit 1 ;;
		esac
		ensure_pwm || { echo "pwm0 不可用" >&2; exit 1; }
		ensure_fan_power
		set_duty_pct "$pct" || { echo "写入失败" >&2; exit 1; }
		log "手动设置 duty=${pct}%"
		cmd_status
		;;
	auto)
		# 手动调速后交回曲线：立即按当前温度设一次，后续由守护进程接管
		resolve_pwm
		case "$PWM_MODE" in
			none)  echo "PWM 通路不可用（pwm0 与 pwmfan/pwm1 都没有）" >&2; exit 1 ;;
			yield) echo "kernel_driver=yield，内核 driver 接管中，无需操作" >&2; exit 1 ;;
		esac
		t=$(read_temp) || { echo "读取温度失败：$TEMP_ZONE" >&2; exit 1; }
		want=$(clamp_duty "$(duty_for_temp "$t")")
		if set_duty_pct "$want"; then
			log "交回自动温控：按曲线立即设到 ${want}%（temp=$t）"
		else
			echo "写入 $PWM_NODE 失败" >&2; exit 1
		fi
		cmd_status
		;;
	*)
		cat >&2 <<-'EOF'
		用法:
		  fanctl [status]     打印温度 / 占空比 / 风扇供电 / 控制模式
		  fanctl curve        打印当前生效的温度-转速曲线
		  fanctl temp         只打印 CPU 温度（摄氏度）
		  fanctl set <1-100>  手动设置占空比（下次温控循环会被曲线纠正）
		  fanctl auto         交回自动温控（立即按曲线设一次）
		  fanctl daemon       前台常驻温控循环（由 procd 拉起）
		EOF
		exit 1
		;;
esac
