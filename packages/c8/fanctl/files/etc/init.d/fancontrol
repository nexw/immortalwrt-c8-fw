#!/bin/sh /etc/rc.common
#
# fancontrol — NRadio C8 PWM 风扇温控服务（procd 托管，崩溃自动重启）
#
# START=96 表示在 fanfallback(95) 之后启动：fanfallback 只做开机 50% 兜底，
# 本服务随后按温度曲线接管。
#
# 配置生效（2026-10-04 真机实测）：procd 的 config.change 触发器 → reload
#   → reload_service() → procd_send_signal（实例的 reload_signal=HUP）
#   → fanctl daemon 收到 SIGHUP 原地重读配置（不断温控、不重启进程，pid 不变）。
#
# ⚠️ 事件源很重要 —— 命令行 `uci commit` **不会**触发（实测）：
#   * uci/libuci 在本构建未链 libubus（`ldd /sbin/uci` 只有 libubox），
#     不会发出 config.change 事件；这是平台级行为，对所有 OpenWrt 服务一致。
#   * `procd_set_param file` 也不能兜底（实测：全机 0 个实例带 file 字段，改文件无反应）。
#   会触发的情形：LuCI 页面（经 rpcd 的 uci ubus 对象）、`ubus call uci set/commit`、
#   或显式 `/etc/init.d/fancontrol reload`。所以命令行改配置写成两行：
#     uci set fancontrol.main.interval='5' && uci commit fancontrol
#     /etc/init.d/fancontrol reload
#
START=96
STOP=10
USE_PROCD=1

start_service() {
	# 内核 pwmfan 驱动就算已接管 pwm0 也要启动：fanctl 会改走 hwmon/pwm1 继续控温。
	# 只有显式配 kernel_driver=yield 时才真的让位。
	if [ "$(uci -q get fancontrol.main.kernel_driver)" = "yield" ]; then
		for h in /sys/class/hwmon/hwmon*; do
			[ -r "$h/name" ] || continue
			if [ "$(cat "$h/name" 2>/dev/null)" = "pwmfan" ]; then
				logger -t fancontrol "kernel_driver=yield 且内核 pwmfan 已接管，跳过 userspace 温控"
				return 0
			fi
		done
	fi

	procd_open_instance
	procd_set_param command /usr/bin/fanctl daemon
	# reload = 给实例发 SIGHUP，由 fanctl 自己重读 /etc/config/fancontrol（见文件头）
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="unlimited"
	procd_close_instance
}

reload_service() {
	# uci 变更 → procd 触发 reload → 这里只发信号，进程不重启
	procd_send_signal fancontrol
}

service_triggers() {
	# config.change 触发器（事件由 LuCI/rpcd 的 uci ubus 对象或显式 ubus 调用产生；
	# 命令行 `uci commit` 不产生事件，见文件头）。它只是把 reload 请求接进来，
	# 真正的重载动作在 reload_service()。
	procd_add_reload_trigger fancontrol
}

stop_service() {
	# 退出温控时把风扇停在"安全档"，避免停服务后风扇全速/停转
	[ -x /usr/bin/fanctl ] && /usr/bin/fanctl set 60 >/dev/null 2>&1
	logger -t fancontrol "已停止，风扇置于 60% 安全档"
}
