#!/bin/sh
#
# ledctl — NRadio C8 (WT9104 / C8-688) 面板/网口指示灯控制 + 夜间定时熄灯
#
# 能控制什么：
#   * 面板 GPIO 灯（leds-gpio）：blue:power(10) / blue:indicator-0(11) /
#     blue:indicator-1(12) / blue:wlan(34)          —— 可用
#   * WiFi 射频指示灯：mt76-phy0 / mt76-phy1        —— 可用
#   * 网口（RJ45）灯：由 MT7531 交换芯片的 LED 引脚驱动，当前固件**没有**
#     软件通路（内核无 mt7530 LED 支持、DTS 的 switch@1f 无 leds 子节点、
#     也没有 switch LED trigger 模块）。脚本会自动探测，将来有了就自动纳入
#     （见 auto_eth_leds），现在为空操作。
#
# 用法：
#   ledctl            等价 status
#   ledctl status     打印时段/模式/每个 LED 的当前状态
#   ledctl off        立刻关灯（手动覆盖，到下次时段边界或 manual_hold 后自动恢复）
#   ledctl on         立刻开灯（同上）
#   ledctl auto       取消手动覆盖，立即按时段执行
#   ledctl toggle     在开/关之间切换
#   ledctl blink [led名] [秒数]  让指定（默认全部）LED 闪烁，用来识别面板灯
#   ledctl schedule   只打印熄灯时段与下一次切换时间
#   ledctl daemon     前台常驻（由 /etc/init.d/ledschedule 经 procd 拉起）
#
# 调度模型（v1.1 起，见 docs/RFC-002-led-fan-packaging.md）：
#   **事件驱动，不做固定间隔轮询**。守护进程只在四种情况下醒来重算：
#     ① 时段边界（off_start / off_end，支持跨零点）
#     ② 手动覆盖到期（manual_hold）
#     ③ 配置变更：LuCI / `ubus call uci commit` → procd 触发器 → SIGHUP
#        （命令行 `uci commit` 不发 config.change 事件，需显式 /etc/init.d/ledschedule reload）
#     ④ 手动切灯：ledctl off/on/auto/toggle/blink 改完状态后显式 reload
#   另外 /etc/hotplug.d/ntp/30-ledschedule 在 NTP 校时（时间跳变）后也会 reload。
#   option max_sleep 是“最长休眠上限”（默认 3600s），纯粹为兜住时钟往回跳的情况；
#   设为 0 即完全不限（纯事件驱动，此时正确性完全依赖 ntp 热插拔）。
#
# 注意：不要用 set -u —— /lib/functions.sh 里引用了未定义的 $IPKG_INSTROOT

STATE=/var/run/ledschedule.state

# ---- 默认值（可被 /etc/config/ledschedule 覆盖）----
ENABLED=1
OFF_START=00:00
OFF_END=06:00
# 最长休眠上限（秒）：0 = 完全不限（纯事件驱动）；见文件头的调度模型
MAX_SLEEP=3600
MANUAL_HOLD=60
AUTO_ETH_LEDS=1
LED_SPECS="blue:power|1 blue:indicator-0| blue:indicator-1|0 blue:wlan|"

ALL_LEDS=      # 运行期展开：面板灯 + 探测到的网口灯

# shell 的 $(( )) 会把带前导零的字面量当八进制解析（busybox ash 不支持 10#），
# 所以 "08"/"09" 会直接报 arithmetic syntax error。凡是要进 $(( )) 的数字先过一遍 dec。
dec() {
	v=$1
	while [ "${v#0}" != "$v" ] && [ ${#v} -gt 1 ]; do v=${v#0}; done
	[ -n "$v" ] || v=0
	echo "$v"
}

load_config() {
	[ -f /etc/config/ledschedule ] || return 0
	[ -f /lib/functions.sh ] || return 0
	if [ -z "$_FN_LOADED" ]; then
		. /lib/functions.sh
		_FN_LOADED=1
	fi
	config_load ledschedule
	config_get_bool ENABLED   main enabled        "$ENABLED"
	config_get OFF_START      main off_start      "$OFF_START"
	config_get OFF_END        main off_end        "$OFF_END"
	config_get INTERVAL       main interval       "$INTERVAL"
	config_get MAX_SLEEP      main max_sleep      "$MAX_SLEEP"
	config_get MANUAL_HOLD    main manual_hold    "$MANUAL_HOLD"
	config_get_bool AUTO_ETH_LEDS main auto_eth_leds "$AUTO_ETH_LEDS"

	_led_list=
	_collect() { _led_list="$_led_list $1"; }
	config_list_foreach main leds _collect
	[ -n "$(echo $_led_list)" ] && LED_SPECS="$_led_list"

	# 避免 "08"/"09" 在 $(( )) 里被当八进制
	INTERVAL=$(dec "$INTERVAL")
	MAX_SLEEP=$(dec "$MAX_SLEEP")
	MANUAL_HOLD=$(dec "$MANUAL_HOLD")
}

# ---- LED 名 / 恢复值解析：'blue:power|1' / 'blue:indicator-0'（无 | = 交给 led 服务）----
led_name()    { echo "${1%%|*}"; }
led_restore() {
	case "$1" in
		*"|"*) r="${1#*|}"; [ -n "$r" ] && echo "$r" || echo __svc__ ;;
		*) echo __svc__ ;;
	esac
}
led_exists()  { [ -e "/sys/class/leds/$1/brightness" ]; }
# LED 是否由 /etc/config/system 声明（是的话「开灯」直接交给 /etc/init.d/led start 重建）
led_in_uci()  { uci -q show system 2>/dev/null | grep -q "\.sysfs='$1'$"; }

# ---- 网口灯探测（当前机型为空；将来 DTS/驱动补齐后自动生效）----
collect_eth_leds() {
	leds=
	for l in /sys/class/leds/*; do
		[ -e "$l/brightness" ] || continue
		n=$(basename "$l")
		case " $ALL_LEDS " in *" $n "*) continue ;; esac
		case "$n" in
			*:lan*|*:wan*|*:eth*|lan*|wan*) ;;
			*)
				# 或：netdev trigger 且绑定到 lan*/wan*/eth* 接口
				dev=$(cat "$l/device_name" 2>/dev/null)
				case "$dev" in lan*|wan*|eth*) ;; *) continue ;; esac
				;;
		esac
		leds="$leds $n|__svc__"
	done
	echo "$leds"
}

build_led_list() {
	ALL_LEDS=""
	for spec in $LED_SPECS; do
		n=$(led_name "$spec")
		led_exists "$n" || continue
		ALL_LEDS="$ALL_LEDS $spec"
	done
	[ "$AUTO_ETH_LEDS" = "1" ] && ALL_LEDS="$ALL_LEDS$(collect_eth_leds)"
}

# ---- 开 / 关 ----
# OFF 之前先存下每个 LED 的原 trigger/device_name，ON 时才能精确还原（
# /etc/init.d/led start 只能还原 /etc/config/system 里声明过的那些）
LEDSNAP=/var/run/ledschedule.leds

led_off() {
	: > "$LEDSNAP"
	for spec in $ALL_LEDS; do
		n=$(led_name "$spec")
		t=$(sed -ne 's/^.*\[\(.*\)\].*$/\1/p' "/sys/class/leds/$n/trigger" 2>/dev/null)
		d=$(cat "/sys/class/leds/$n/device_name" 2>/dev/null)
		echo "$n|$t|$d" >> "$LEDSNAP"
		echo none > "/sys/class/leds/$n/trigger" 2>/dev/null
		echo 0    > "/sys/class/leds/$n/brightness" 2>/dev/null
	done
}

led_on() {
	# ① 让 OpenWrt 的 led 服务按 /etc/config/system 重建全部已声明的 LED
	#    （netdev 这类复杂 trigger 只有它知道 device_name / mode）
	[ -x /etc/init.d/led ] && /etc/init.d/led start >/dev/null 2>&1
	# ② 不在 /etc/config/system 里的 LED：按关灯前的快照还原 trigger/device_name
	if [ -s "$LEDSNAP" ]; then
		while IFS='|' read -r n t d; do
			[ -n "$n" ] || continue
			led_exists "$n" || continue
			led_in_uci "$n" && continue
			if [ -n "$t" ] && [ "$t" != none ]; then
				echo "$t" > "/sys/class/leds/$n/trigger" 2>/dev/null
				[ -n "$d" ] && echo "$d" > "/sys/class/leds/$n/device_name" 2>/dev/null
			fi
		done < "$LEDSNAP"
	fi
	# ③ 配置里写了 |亮度的，最后覆写亮度（power 常亮、indicator-1 熄灭等）
	for spec in $ALL_LEDS; do
		n=$(led_name "$spec")
		r=$(led_restore "$spec")
		[ "$r" = "__svc__" ] && continue
		echo "$r" > "/sys/class/leds/$n/brightness" 2>/dev/null
	done
}

# 所有目标 LED 都处于「trigger=none 且 brightness=0」才算 off
leds_state() {
	for spec in $ALL_LEDS; do
		n=$(led_name "$spec")
		[ "$(cat /sys/class/leds/$n/brightness 2>/dev/null)" = "0" ] || { echo on; return; }
		case "$(cat /sys/class/leds/$n/trigger 2>/dev/null)" in
			*'[none]'*) ;;
			*) echo on; return ;;
		esac
	done
	echo off
}

# ---- 时段计算 ----
valid_hhmm() { case "$1" in [0-2][0-9]:[0-5][0-9]) [ "${1%%:*}" -le 23 ] ;; *) return 1 ;; esac; }
# 注意：${x#0} 去掉前导零，否则 "08"/"09" 在 $(( )) 里会被当非法八进制而报错
hhmm_to_min() { h=${1%%:*}; m=${1##*:}; echo $(( ${h#0} * 60 + ${m#0} )); }

in_off_window() {
	[ -n "$OFF_START" ] || return 1
	[ -n "$OFF_END" ] || return 1
	valid_hhmm "$OFF_START" || return 1
	valid_hhmm "$OFF_END" || return 1
	[ "$OFF_START" = "$OFF_END" ] && return 1

	s=$(hhmm_to_min "$OFF_START")
	e=$(hhmm_to_min "$OFF_END")
	n=$(hhmm_to_min "$(date +%H:%M)")

	if [ "$s" -lt "$e" ]; then
		[ "$n" -ge "$s" ] && [ "$n" -lt "$e" ] && return 0
	else
		# 跨零点，例如 22:30 -> 07:00
		if [ "$n" -ge "$s" ] || [ "$n" -lt "$e" ]; then return 0; fi
	fi
	return 1
}

# ---- 手动覆盖状态 ----
state_set() { printf 'mode=%s\nhold_until=%s\n' "$1" "$2" > "$STATE"; }
state_get() { # $1=key
	[ -f "$STATE" ] || return 1
	sed -n "s/^$1=//p" "$STATE" | head -1
}

manual_active() {
	[ "$(state_get mode)" = "manual" ] || return 1
	until=$(state_get hold_until)
	[ -n "$until" ] || return 1
	[ "$(date +%s)" -lt "$until" ] || return 1
	return 0
}

hold_expiry() {
	# 手动覆盖的到期时间：min(现在 + MANUAL_HOLD 分钟, 下一个时段边界)
	now=$(date +%s)
	until=$(( now + MANUAL_HOLD * 60 ))
	[ "$MANUAL_HOLD" -le 0 ] && until=$(( now + 86400 ))
	today=$(date +%s -d "$(date +%Y-%m-%d) 00:00:00" 2>/dev/null)
	if [ -n "$today" ]; then
		for b in "$OFF_START" "$OFF_END"; do
			valid_hhmm "$b" || continue
			bt=$(( today + $(hhmm_to_min "$b") * 60 ))
			if [ "$bt" -gt "$now" ] && [ "$bt" -lt "$until" ]; then until=$bt; fi
			bt2=$(( bt + 86400 ))
			if [ "$bt2" -gt "$now" ] && [ "$bt2" -lt "$until" ]; then until=$bt2; fi
		done
	fi
	echo "$until"
}

# ---- 事件驱动调度：算“下一次该醒来的绝对时刻” ----

# 今天 00:00 的 epoch。只用 date 的字段做减法，不依赖 date -d "YYYY-MM-DD HH:MM:SS"
day_start() {
	now=$(date +%s)
	h=$(dec "$(date +%H)"); m=$(dec "$(date +%M)"); s=$(dec "$(date +%S)")
	echo $(( now - (h * 3600 + m * 60 + s) ))
}

# 下一个时段边界（绝对 epoch）；时段无效时无输出
next_boundary() {
	# off_start == off_end 与 in_off_window 保持一致，视为未启用定时
	[ -n "$OFF_START" ] && [ "$OFF_START" != "$OFF_END" ] || return 0
	now=$1
	d0=$(day_start)
	best=
	for b in "$OFF_START" "$OFF_END"; do
		valid_hhmm "$b" || continue
		t=$(( d0 + $(hhmm_to_min "$b") * 60 ))
		[ "$t" -le "$now" ] && t=$(( t + 86400 ))
		if [ -z "$best" ] || [ "$t" -lt "$best" ]; then best=$t; fi
	done
	[ -n "$best" ] && echo "$best"
	return 0
}

# 下一次必须醒来的绝对 epoch = min(时段边界, 手动覆盖到期, 最长休眠上限)
next_wake() {
	now=$(date +%s)
	wake=
	if manual_active; then
		u=$(state_get hold_until)
		case "$u" in ''|*[!0-9]*) ;; *) wake=$u ;; esac
	fi
	if [ "$ENABLED" = "1" ]; then
		b=$(next_boundary "$now")
		if [ -n "$b" ]; then
			if [ -z "$wake" ] || [ "$b" -lt "$wake" ]; then
				wake=$b
			fi
		fi
		# 最长休眠上限只在本服务启用时才需要：禁用时不动灯，没有“漏边界”风险
		if [ "${MAX_SLEEP:-0}" -gt 0 ]; then
			c=$(( now + MAX_SLEEP ))
			if [ -z "$wake" ] || [ "$c" -lt "$wake" ]; then wake=$c; fi
		fi
	fi
	[ -n "$wake" ] || wake=$(( now + 86400 ))
	[ "$wake" -le "$now" ] && wake=$(( now + 1 ))
	echo "$wake"
}

# 事件驱动休眠：sleep 放后台、前台只 wait。
# busybox ash 的 trap 能立刻打断 wait；而直接 `sleep N` 必须睡满才执行 trap
# （实机验证见 docs/RFC-002-led-fan-packaging.md §3.1）。
sleep_until() {
	target=$1
	now=$(date +%s)
	d=$(( target - now ))
	[ "$d" -gt 0 ] || d=1
	sleep "$d" &
	_sleep_pid=$!
	wait "$_sleep_pid"
	_sleep_pid=
	return 0
}

sleep_pid_kill() {
	[ -n "$_sleep_pid" ] && kill "$_sleep_pid" 2>/dev/null
	_sleep_pid=
	return 0
}

# 手动切灯/状态变更后通知守护进程重算唤醒时刻。
# 走 reload（procd_send_signal）而不是 restart：restart 会经 stop_service，
# 夜里会“熄灯→亮一下→再熄灯”，且会清掉刚写的手动覆盖状态。
sync_daemon() {
	[ -x /etc/init.d/ledschedule ] || return 0
	/etc/init.d/ledschedule running >/dev/null 2>&1 || return 0
	/etc/init.d/ledschedule reload >/dev/null 2>&1
	return 0
}

# ---- 输出 ----
log() {
	logger -t ledctl "$*" 2>/dev/null
	[ -t 1 ] && echo "$(date '+%F %T') $*"
	return 0
}

fmt_led() {
	spec=$1
	n=$(led_name "$spec")
	t=$(sed -ne 's/^.*\[\(.*\)\].*$/\1/p' "/sys/class/leds/$n/trigger" 2>/dev/null)
	b=$(cat "/sys/class/leds/$n/brightness" 2>/dev/null)
	led_in_uci "$n" && src=uci || src=ledctl
	printf '  %-18s trigger=%-12s brightness=%-4s 恢复来源=%s\n' "$n" "${t:-?}" "${b:-?}" "$src"
}

cmd_status() {
	build_led_list
	printf '熄灯时段   : %s -> %s  (%s)\n' "$OFF_START" "$OFF_END" \
		"$(in_off_window && echo '现在是关灯时段' || echo '现在是开灯时段')"
	printf '服务开关   : %s   最长休眠 %ss   手动覆盖上限 %s 分钟\n' \
		"$([ "$ENABLED" = 1 ] && echo enabled || echo disabled)" "$MAX_SLEEP" "$MANUAL_HOLD"
	m=$(state_get mode); [ -z "$m" ] && m=auto
	if [ "$m" = manual ] && manual_active; then
		printf '当前模式   : manual（手动覆盖中，%s 到期）\n' "$(date -d "@$(state_get hold_until)" '+%F %T' 2>/dev/null || echo "epoch $(state_get hold_until)")"
	else
		printf '当前模式   : auto（按时段自动执行）\n'
	fi
	printf 'LED 状态   : %s\n' "$(leds_state)"
	printf '受控 LED（%s 个）:\n' "$(echo $ALL_LEDS | wc -w)"
	for spec in $ALL_LEDS; do fmt_led "$spec"; done
}

cmd_blink() {
	target=${1:-}
	secs=${2:-15}
	case "$secs" in ''|*[!0-9]*) echo "用法: ledctl blink [led名] [秒数]" >&2; return 1 ;; esac

	build_led_list   # 必须先建起来：was/恢复都看 ALL_LEDS，否则会误判为 off
	if [ -n "$target" ]; then
		led_exists "$target" || { echo "没有这个 LED: $target" >&2; return 1; }
		specs="$target|"
	else
		specs=$ALL_LEDS
	fi
	[ -n "$(echo $specs)" ] || { echo "没有可闪烁的 LED" >&2; return 1; }

	was=$(leds_state)
	for spec in $specs; do
		n=$(led_name "$spec")
		echo timer > "/sys/class/leds/$n/trigger" 2>/dev/null
		echo 500   > "/sys/class/leds/$n/delay_on" 2>/dev/null
		echo 500   > "/sys/class/leds/$n/delay_off" 2>/dev/null
	done
	echo "闪烁 $secs 秒（0.5s 亮 / 0.5s 灭）：$(echo $specs | tr " " ",")"
	sleep "$secs"
	[ "$was" = off ] && led_off || led_on
	echo "已恢复为 $was"
}

cmd_schedule() {
	printf '熄灯时段: %s -> %s\n' "$OFF_START" "$OFF_END"
	printf '当前时间: %s\n' "$(date '+%F %T %Z')"
	in_off_window && echo '当前应为: 关灯' || echo '当前应为: 开灯'
}

cmd_apply() {
	build_led_list
	if [ "$(echo $ALL_LEDS | wc -w)" = 0 ]; then
		echo "错误：没有找到任何可控制的 LED" >&2
		return 1
	fi
	want=$1
	cur=$(leds_state)
	if [ "$want" = off ] && [ "$cur" != off ]; then
		led_off
		log "关灯（$([ "$2" = manual ] && echo 手动 || echo 定时)）"
	elif [ "$want" = on ] && [ "$cur" = off ]; then
		led_on
		log "开灯（$([ "$2" = manual ] && echo 手动 || echo 定时)）"
	else
		[ "$2" = manual ] && log "已经是 $want 状态，无需改动"
	fi
}

cmd_daemon() {
	build_led_list
	if [ "$(echo $ALL_LEDS | wc -w)" = 0 ]; then
		log "错误：没有找到任何可控制的 LED，退出"
		return 1
	fi

	# 旧配置迁移提示（v1.0 的 option interval 是轮询间隔，v1.1 起已废弃）
	_legacy=$(uci -q get ledschedule.main.interval)
	[ -n "$_legacy" ] && log "提示：ledschedule.main.interval='$_legacy' 已废弃（v1.1 起改为事件驱动），请改用 max_sleep（当前 ${MAX_SLEEP}s）"

	# 见文件头“调度模型”：HUP = 原地重载；TERM/INT = 收尾退出（顺手收掉后台 sleep）
	trap 'reload_wanted=1' HUP
	trap 'sleep_pid_kill; exit 0' TERM INT
	trap 'sleep_pid_kill' EXIT
	reload_wanted=0

	last_mode= last_want= manual_was=
	log "指示灯定时启动（事件驱动）：$OFF_START-$OFF_END 关灯，最长休眠 ${MAX_SLEEP}s，受控 $(echo $ALL_LEDS | wc -w) 个 LED"

	while :; do
		if [ "$reload_wanted" = "1" ]; then
			# uci 变更 / 手动切灯 / NTP 校时都会到这里：重读配置与状态，并强制重新评估
			reload_wanted=0
			load_config
			build_led_list
			last_want=
			log "已重载：$OFF_START-$OFF_END 关灯，最长休眠 ${MAX_SLEEP}s，受控 $(echo $ALL_LEDS | wc -w) 个 LED"
		fi

		if [ "$ENABLED" = "0" ]; then
			[ "$last_want" != disabled ] && log "服务已禁用（uci: ledschedule.main.enabled=0），不干预 LED"
			last_want=disabled
		elif manual_active; then
			if [ "$manual_was" != 1 ]; then
				log "手动覆盖生效中，暂停自动切换（$([ -n "$(state_get hold_until)" ] && date -d "@$(state_get hold_until)" '+%F %T' 2>/dev/null || echo "epoch $(state_get hold_until)") 到期）"
				manual_was=1
			fi
		else
			if [ "$manual_was" = 1 ]; then
				log "手动覆盖结束，恢复自动切换"
				state_set auto 0
				manual_was=
			fi
			if in_off_window; then want=off; else want=on; fi
			if [ "$want" != "$last_want" ]; then
				cmd_apply "$want" auto
				last_want=$want
			fi
		fi

		# 睡到下一个事件：时段边界 / 手动覆盖到期 / 最长休眠上限；
		# HUP 会立刻打断这个 wait，不需要等待睡满。
		sleep_until "$(next_wake)"
	done
}

load_config
case "${1:-status}" in
	status)   cmd_status ;;
	schedule) cmd_schedule ;;
	blink)    cmd_blink "${2:-}" "${3:-15}"; sync_daemon ;;
	daemon)   cmd_daemon ;;
	# 内部命令：停服务时把灯按时段交还，但不再回头 reload 守护进程（此刻实例正在退出）
	restore)  state_set auto 0; cmd_apply "$(in_off_window && echo off || echo on)" auto ;;
	off)      cmd_apply off manual; state_set manual "$(hold_expiry)"; sync_daemon ;;
	on)       cmd_apply on  manual; state_set manual "$(hold_expiry)"; sync_daemon ;;
	auto)     state_set auto 0; log "取消手动覆盖，回到自动"; cmd_apply "$(in_off_window && echo off || echo on)" auto; sync_daemon ;;
	toggle)   if [ "$(build_led_list; leds_state)" = off ]; then
			cmd_apply on manual; state_set manual "$(hold_expiry)"
		else
			cmd_apply off manual; state_set manual "$(hold_expiry)"
		fi
		sync_daemon ;;
	*)
		cat >&2 <<-'EOF'
		用法:
		  ledctl [status]   时段 / 模式 / 每个 LED 的当前状态
		  ledctl schedule   熄灯时段与当前应处状态
		  ledctl off        立刻关灯（手动覆盖）
		  ledctl on         立刻开灯（手动覆盖）
		  ledctl toggle     开/关切换
		  ledctl auto       取消手动覆盖，立即按时段执行
		  ledctl blink [led名] [秒数]
		                   让某个（默认全部）LED 快速闪烁，用来识别面板灯
		  ledctl daemon     前台常驻（procd 拉起）
		  ledctl restore    内部命令：按时段重算状态（停服务时由 init 脚本调用）
		EOF
		exit 1
		;;
esac
