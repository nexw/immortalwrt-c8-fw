#!/bin/sh /etc/rc.common
#
# ledschedule — 夜间定时关闭面板/网口指示灯（procd 托管）
#
# START=97：在 led(96) 之后启动，保证能覆盖 led 服务刚应用的默认状态。
#
# 配置/状态生效（2026-10-04 真机实测）：三条路径都落到同一个 reload：
#   ① LuCI 页面 / `ubus call uci set,commit` → procd 的 config.change 触发器 → reload
#   ② `ledctl off|on|auto|blink` → 改完 /var/run/ledschedule.state 后显式 reload
#   ③ NTP 校时（/etc/hotplug.d/ntp/30-ledschedule）→ reload
#   三者都经 procd_send_signal（实例的 reload_signal=HUP）→ ledctl daemon 收 SIGHUP
#   原地重读配置与状态、重算下一次唤醒时刻（pid 不变、无 stop_service、无闪烁）。
#
# ⚠️ 事件由谁发（2026-10-04 实测）：procd 包自带的 /sbin/reload_config（md5 比对
#   `uci show`，对变更过的包发 config.change；LuCI 的 Save & Apply 就是走它）。
#   命令行 `uci commit` 自身**不发**事件（本构建 uci/libuci 未链 libubus）→ 只 commit
#   不会生效；`procd_set_param file` 也不能兜底（全机 0 实例带 file 字段）。
#   命令行改配置写成两行：
#     uci set ledschedule.main.off_start='22:30' && uci commit ledschedule
#     /sbin/reload_config          # 或只针对本服务：/etc/init.d/ledschedule reload
START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ledctl daemon
	# reload = 给实例发 SIGHUP，由 ledctl 自己重读配置与手动覆盖状态（见文件头）
	procd_set_param reload_signal HUP
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# uci 变更 / 手动切灯 / NTP 校时 → 只发信号，不重启进程。
	# 走 reload 而不是 restart 是有意的：restart 会经过 stop_service，夜里会闪一下
	# （熄灯→亮一下→再熄灯），且会清掉手动覆盖状态。见 docs/RFC-002 §3.1。
	procd_send_signal ledschedule
}

service_triggers() {
	# 对应上面路径 ①；事件由 LuCI/rpcd 的 uci ubus 对象或显式 ubus 调用产生
	# （命令行 `uci commit` 不产生，见文件头）。
	procd_add_reload_trigger ledschedule
}

stop_service() {
	# 真正停服务/禁用时把灯按时段交还（会清掉手动覆盖），不要让用户以为灯坏了。
	# reload 不会走到这里，所以不会出现上面说的闪烁。
	# 用 restore 而不是 auto：auto 会再回头 reload 一次守护进程，没有意义。
	[ -x /usr/bin/ledctl ] && /usr/bin/ledctl restore >/dev/null 2>&1
	logger -t ledschedule "已停止，指示灯按 open 状态恢复"
}
